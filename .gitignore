# environments (one shared .venv at the top level)
.venv/
venv/
__pycache__/
*.pyc
.DS_Store

# Clash Royale data is not committed: re-download with `python src/download_data.py`
# (raw ~1.4 GB, processed ~100 MB). The sushi data (~1.9 MB) in lcl_heterogeneity/data IS committed
# (unzipped; the zip itself is left out). Keep this repository private: Kamishima's licence does not
# allow redistributing the sushi data without permission.
data/
!lcl_heterogeneity/data/
lcl_heterogeneity/data/raw/*.zip

# Clash Royale training checkpoints (deleted automatically when a run finishes)
clash_royale/results/runs/*.ckpt
clash_royale/results/runs/*.tmp

# Kaggle runs (kaggle/push.py): generated notebook and downloaded outputs
clash_royale/kaggle/build/
clash_royale/kaggle/out/

# copies of the code/data that Kaggle kernels write next to their outputs
lcl_heterogeneity/results/dlcl/kaggle/*/lcl/
